  - guidHash: -252458135
    text: Elderseeds are full of juice but it's not so easy to get.
  - guidHash: 1976540978
    text: "\u7279\u6B8A\u8C03\u6599"
  - guidHash: -460986270
    text: "\u653B\u51FB\u98DF\u7269\u65F6\u6709\u4E00\u5B9A\u51E0\u7387\u8F6C\u5316\u98DF\u7269\u3002"
  - guidHash: -950523629
    text: "\u5168\u91D1\u5C5E\u5916\u58F3"
  - guidHash: -952900758
    text: "\u589E\u52A05\u70B9\u62A4\u7532\u503C\uFF0C\u5E76\u5C06\u4F60\u7684\u6700\u5927\u751F\u547D\u503C\u56FA\u5B9A\u8BBE\u4E3A1\u3002\u5C06\u6240\u6709\u98DF\u7269\u66FF\u6362\u4E3A\u62A4\u7532\u788E\u7247\u3002\u514D\u75AB\u6301\u7EED\u4F24\u5BB3\u6548\u679C\u3002"
  - guidHash: 1145511058
    text: "\u8096\u53E4\u5C14\u4E4B\u793C"
  - guidHash: -525751354
    text: "\u968F\u673A\u79FB\u96642\u4E2A\u5723\u7269\uFF0C\u5E76\u968F\u673A\u83B7\u5F974\u4E2A\u5723\u7269\u3002"
